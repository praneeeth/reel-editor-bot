# --- Telegram ---
# Token from @BotFather
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user IDs allowed to use the bot (get yours from @userinfobot).
# The bot runs on YOUR Claude/Codex subscription, so it must never serve anyone else.
ALLOWED_USER_IDS=

# Optional local Bot API server (lifts the 20 MB download / 50 MB upload limits).
# Leave empty to use the hosted api.telegram.org. See docker-compose.yml.
TELEGRAM_API_BASE_URL=
# Host folder that is mounted as /var/lib/telegram-bot-api in the local server container.
TELEGRAM_API_DATA_DIR=./tg-bot-api-data
# Only needed by docker-compose for the local Bot API server (https://my.telegram.org/apps).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# --- Agent ---
# claude  -> `claude -p` logged in with your Pro/Max plan (default)
# codex   -> `codex exec` logged in with your ChatGPT plan (backup)
AGENT_BACKEND=claude
# Optional model override passed to the CLI (empty = CLI default)
AGENT_MODEL=
# Hard wall-clock limit per agent call, seconds
AGENT_TIMEOUT_S=1800
# Max agent turns per call (claude --max-turns)
AGENT_MAX_TURNS=60

# Streamlined mode: <=10 self-eval screenshot checks, no animation overlays,
# every revision starts a fresh agent session from a short summary.
LEAN_MODE=true
SELF_EVAL_CAP=10

# --- Transcription (ElevenLabs Scribe, used by video-use) ---
ELEVENLABS_API_KEY=

# --- Storage ---
JOBS_DIR=./jobs
# Job folders are deleted this many hours after the final video is delivered
CLEANUP_AFTER_HOURS=24
